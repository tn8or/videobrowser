# CI image for videobrowser: Python + Cairo build deps + ffmpeg + git.
# Python minor must match /.python-version (CI verifies before build/pull).
# Rebuild cadence: .github/workflows/ci-image.yml (schedule + Dockerfile changes).
# Renovate: digest-only updates for this FROM (minor/major disabled); optional
# "# renovate: datasource=..." ARG/ENV *_VERSION= pins for other tools.
# Manual:
#   PY=$(tr -d '[:space:]' < .python-version)
#   docker buildx build --platform linux/amd64 \
#     -f Dockerfile.ci -t "ghcr.io/tn8or/videobrowser/ci:${PY}-bookworm" --push .
FROM python:3.12-bookworm@sha256:dbbe4ceb97851e2e5fa83798b239811f871cb743b259ba3563737349f6bcfaa0

ARG DOCKERFILE_HASH=unknown
LABEL dockerfile.hash="${DOCKERFILE_HASH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libcairo2-dev \
        ffmpeg \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
