# CI image for videobrowser: Python + Cairo build deps + ffmpeg + git.
# Rebuild cadence: .github/workflows/ci-image.yml (schedule + Dockerfile changes).
# Renovate: updates the FROM tag/digest (docker:pinDigests) and any version-pinned
# apt packages; optional "# renovate: datasource=..." ARG/ENV _VERSION= lines.
# Manual:
#   docker buildx build --platform linux/amd64 \
#     -f Dockerfile.ci -t ghcr.io/tn8or/videobrowser/ci:3.12-bookworm --push .
FROM python:3.14-bookworm@sha256:bfb689a7986adc6d5f16722e06c78e755efe4062e56276715fef450cbad09436

ARG DOCKERFILE_HASH=unknown
LABEL dockerfile.hash="${DOCKERFILE_HASH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libcairo2-dev \
        ffmpeg \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
