{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeRequireAllStatusChecks",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "at any time"
  ],
  "prHourlyLimit": 1,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "ignorePaths": [
    "**/requirements.txt"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile\\.ci$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Explicit # renovate datasource pins for ARG/ENV *_VERSION in Dockerfile.ci",
      "managerFilePatterns": [
        "/(^|/)Dockerfile\\.ci$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))?(?: packageName=(?<packageName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s+(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+)\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Python runtime dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependencies"],
      "groupName": "Python dependencies"
    },
    {
      "description": "Group Python optional / dev dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["optionalDependencies", "devDependencies"],
      "groupName": "Python optional dependencies"
    },
    {
      "description": "CI Dockerfile.ci: base image digests/tags and pinned apt packages",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile.ci"],
      "groupName": "CI Dockerfile"
    },
    {
      "description": "CI Dockerfile.ci: custom *_VERSION pins",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["Dockerfile.ci"],
      "groupName": "CI Dockerfile"
    }
  ]
}
