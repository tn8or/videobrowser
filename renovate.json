{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeRequireAllStatusChecks",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "at any time"
  ],
  "prHourlyLimit": 1,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile\\.ci$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Shared CI Python minor (.python-version ↔ Dockerfile.ci FROM)",
      "managerFilePatterns": [
        "/(^|/)\\.python-version$/",
        "/(^|/)Dockerfile\\.ci$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+)\\s*$",
        "FROM python:(?<currentValue>\\d+\\.\\d+)-bookworm@"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "python",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "customType": "regex",
      "description": "Explicit # renovate datasource pins for ARG/ENV *_VERSION in Dockerfile.ci",
      "managerFilePatterns": [
        "/(^|/)Dockerfile\\.ci$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))?(?: packageName=(?<packageName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s+(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+)\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Python deps from pyproject.toml (pep621/poetry managers)",
      "matchManagers": ["pep621", "poetry"],
      "matchFileNames": ["pyproject.toml"],
      "groupName": "Python pyproject"
    },
    {
      "description": "CI Python image: digests only — no 3.12→3.14 style jumps",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "CI Dockerfile.ci: base image digests and pinned apt packages",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile.ci"],
      "groupName": "CI Dockerfile"
    },
    {
      "description": "CI Dockerfile.ci: custom *_VERSION pins",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["Dockerfile.ci"],
      "groupName": "CI Dockerfile"
    }
  ]
}
